__pycache__/
*.pyc
.venv/
.pytest_cache/
workspace/*
!workspace/README.md
!workspace/*.dvc
# git never descends into an ignored directory, so `!workspace/**/*.dvc` would
# be a no-op: every subdirectory holding pointers is re-included explicitly.
!workspace/_archives/
workspace/_archives/*
!workspace/_archives/*.dvc
!workspace/chats/
workspace/chats/*
!workspace/chats/*.dvc
.superpowers/
config/remotes.yml
config/notebooklm.yml
config/chats.yml
# Machine-local DVC remote (endpoint + bucket); credentials live in config.local
.dvc/config
.env
.env.*
!.env_template
# Package build output
*.egg-info/
build/
dist/
site/
# Experiments module: generated pipeline data and container images
*.sif
pipelines/*/data/
pipelines/*/stages/*/env/
# Editor and tool backups (e.g. .dvc/config.bak while migrating)
*.bak
# Runtime state and lock files written by scieflow.core.store / jobs
.scieflow/
*.yml.lock
*.yaml.lock
*.json.lock
*.jsonl.lock
