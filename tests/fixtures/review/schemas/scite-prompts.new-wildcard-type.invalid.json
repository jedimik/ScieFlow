{
  "version": 1,
  "wildcards": {
    "patient_id": {
      "max_chars": 10
    }
  },
  "prompts": [
    {
      "id": "contrasting-evidence",
      "stage": "review",
      "applies_to": [
        "results",
        "discussion"
      ],
      "instruction": "For each claim {{claim}} (citing {{claim_dois}}), say whether the bundle supports it; quote verbatim. Usage: {{doi_usage}}. Section: {{section:results}}. Notes: {{file:notes/reviewer.md}}.",
      "queries": [
        {
          "source": "scite_mcp",
          "tool": "citation_graph",
          "template": "{{seed_dois}}",
          "limit": 10
        },
        {
          "source": "scite_public",
          "template": "{{doi}}"
        }
      ]
    },
    {
      "id": "novelty",
      "stage": "review",
      "applies_to": [
        "introduction"
      ],
      "enabled": false,
      "instruction": "Check every novelty claim: {{novelty_claim}}.",
      "queries": [
        {
          "source": "scite_mcp",
          "tool": "search_literature",
          "template": "{{novelty_claim}}",
          "limit": 5
        }
      ]
    }
  ]
}
