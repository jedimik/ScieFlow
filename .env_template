# ScieFlow Environment Variables Template
# Copy this file to .env and fill in your values.
# .env is ignored by both Git and DVC.

# ==============================================================================
# S3 / DVC Remote Storage Configuration
# ==============================================================================
# S3 Remote URL or endpoint shorthand:
# e.g., s3://dvc-projects/scieflow
# or:   s3.cl4.du.cesnet.cz://dvc-projects/scieflow
DVC_S3_URL=s3://bucket/name

# S3 Custom Endpoint URL (optional if specified directly in DVC_S3_URL):
# e.g., https://s3.cl4.du.cesnet.cz or https://s3.amazonaws.com
DVC_S3_ENDPOINT_URL=

# S3 Region (e.g., eu-central-1, us-east-1)
DVC_S3_REGION=eu-central-1

# S3 Remote Name in DVC config (default: s3remote)
DVC_S3_REMOTE_NAME=s3remote

# Credentials (AWS standard or custom S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional AWS Profile (if using ~/.aws/credentials instead of keys)
# AWS_PROFILE=default

# ==============================================================================
# LLM / Sub-Agent API Keys (if running online coordinators or support agents)
# ==============================================================================
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
