{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScieFlow research cross-review",
  "type": "object",
  "required": ["agent", "reviewed", "per_paper", "summary"],
  "properties": {
    "agent": {"type": "string"},
    "reviewed": {"type": "string"},
    "per_paper": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "score", "verdict"],
        "properties": {
          "doi": {"type": ["string", "null"]},
          "title": {"type": "string"},
          "score": {"type": "integer", "minimum": 1, "maximum": 5},
          "verdict": {"enum": ["strong", "ok", "weak", "duplicate", "off-topic"]},
          "comment": {"type": "string"}
        }
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "why"],
        "properties": {
          "doi": {"type": ["string", "null"]},
          "title": {"type": "string"},
          "why": {"type": "string"}
        }
      }
    },
    "summary": {"type": "string"}
  }
}
