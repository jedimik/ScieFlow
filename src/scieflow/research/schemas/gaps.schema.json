{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScieFlow research gap analysis",
  "type": "object",
  "required": ["agent", "topic", "gaps", "hypotheses"],
  "properties": {
    "agent": {"type": "string"},
    "topic": {"type": "string"},
    "gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "evidence", "novelty_rationale"],
        "properties": {
          "id": {"type": "string", "pattern": "^G\\d+$"},
          "statement": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "ref"],
              "properties": {
                "kind": {"enum": ["paper", "data", "article"]},
                "ref": {"type": "string", "minLength": 1}
              }
            }
          },
          "novelty_rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "gap", "statement", "testable_prediction", "confidence", "experiment"],
        "properties": {
          "id": {"type": "string", "pattern": "^H\\d+$"},
          "gap": {"type": "string", "pattern": "^G\\d+$"},
          "statement": {"type": "string", "minLength": 1},
          "testable_prediction": {"type": "string", "minLength": 1},
          "confidence": {"type": "integer", "minimum": 1, "maximum": 5},
          "experiment": {
            "type": "object",
            "required": ["design", "data_needed", "methods", "feasibility_note"],
            "properties": {
              "design": {"type": "string", "minLength": 1},
              "data_needed": {"type": "string", "minLength": 1},
              "methods": {"type": "string", "minLength": 1},
              "feasibility_note": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
