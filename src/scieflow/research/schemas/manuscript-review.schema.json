{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scieflow.local/schemas/manuscript-review.schema.json",
  "title": "ScieFlow research manuscript cross-review (pass A blind / pass B evidence)",
  "description": "Version 1. Files without `pass` are blind reviews (the pre-scite format); every field added for the two-pass review is optional, so older files keep validating. An evidence pass (pass B) adds per-comment evidence with verbatim quotes, changed_from_blind, at most two follow-up requests and scite_status.",
  "type": "object",
  "required": [
    "agent",
    "reviewed",
    "recommendation",
    "major",
    "minor",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "reviewed": {
      "type": "string",
      "minLength": 1
    },
    "recommendation": {
      "enum": [
        "ACCEPT",
        "MINOR REVISION",
        "MAJOR REVISION"
      ]
    },
    "major": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "location",
          "problem",
          "why_it_matters",
          "resolution"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^M[0-9]+$",
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "why_it_matters": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            }
          },
          "changed_from_blind": {
            "$ref": "#/$defs/changed_from_blind"
          }
        }
      }
    },
    "minor": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "location",
          "comment"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^m[0-9]+$",
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "comment": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            }
          },
          "changed_from_blind": {
            "$ref": "#/$defs/changed_from_blind"
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": 1
    },
    "pass": {
      "enum": [
        "blind",
        "evidence"
      ],
      "default": "blind"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "scite_status": {
      "$ref": "#/$defs/scite_status"
    },
    "followup_requests": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "reason"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "query"
            ]
          },
          {
            "required": [
              "dois"
            ]
          }
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "dois": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "$ref": "#/$defs/doi"
            }
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "doi": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^10\\.[0-9]{4,9}/[^\\s]+$",
      "not": {
        "pattern": "(^|/)\\.\\.(/|$)"
      },
      "allOf": [
        {
          "not": {
            "pattern": "[\\r\\n]"
          }
        }
      ]
    },
    "source": {
      "enum": [
        "crossref",
        "scite_public",
        "europepmc",
        "scite_mcp",
        "pubtator",
        "ctgov",
        "openalex"
      ]
    },
    "stance": {
      "enum": [
        "supporting",
        "contrasting",
        "neutral"
      ]
    },
    "scite_status": {
      "enum": [
        "ok",
        "off",
        "quota",
        "unavailable"
      ]
    },
    "changed_from_blind": {
      "enum": [
        "new",
        "unchanged",
        "strengthened",
        "weakened",
        "withdrawn"
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "doi",
        "quote",
        "stance",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "doi": {
          "$ref": "#/$defs/doi"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "stance": {
          "$ref": "#/$defs/stance"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "claim": {
          "type": "string",
          "pattern": "^C[0-9]+$",
          "not": {
            "pattern": "[\\r\\n]"
          }
        },
        "location": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "pass"
        ],
        "properties": {
          "pass": {
            "const": "evidence"
          }
        }
      },
      "then": {
        "required": [
          "scite_status"
        ],
        "properties": {
          "major": {
            "items": {
              "required": [
                "changed_from_blind"
              ]
            }
          },
          "minor": {
            "items": {
              "required": [
                "changed_from_blind"
              ]
            }
          }
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "scite_status"
              ]
            },
            {
              "required": [
                "followup_requests"
              ]
            }
          ]
        },
        "properties": {
          "major": {
            "items": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "evidence"
                    ]
                  },
                  {
                    "required": [
                      "changed_from_blind"
                    ]
                  }
                ]
              }
            }
          },
          "minor": {
            "items": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "evidence"
                    ]
                  },
                  {
                    "required": [
                      "changed_from_blind"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
