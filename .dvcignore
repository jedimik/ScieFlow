# Add patterns of files dvc should ignore, which could improve
# the performance. Learn more at
# https://dvc.org/doc/user-guide/dvcignore

# Python & testing caches
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
venv/

# Temporary and build artifacts
*.tmp
*.log
*.sif
build/
dist/
site/

# Git and editor metadata
.git/
.superpowers/
.idea/
.vscode/
.env
.env.*

# Git-tracked repository code, configuration, and docs
# DVC should never touch or scan code, docs, or package sources
/config/
/docs/
/schemas/
/scripts/
/setup/
/skills/
/tests/
/src/
/pipelines/
/envs/
/.github/
mkdocs.yml
AGENTS.md
CLAUDE.md
README.md
pyproject.toml
uv.lock
